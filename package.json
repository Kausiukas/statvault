{
  "name": "statvault",
  "version": "1.0.2",
  "private": true,
  "description": "The Interactive Source-of-Truth Database for Warhammer 40,000 Total War (Warcore Engine)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "build:schemas": "npm run build --workspace=@statvault/schemas",
    "postinstall": "npm run build --workspace=@statvault/schemas",
    "validate:data": "npm run validate:data --workspace=@statvault/schemas",
    "task:wiki-build": "ts-node scripts/daily-wiki-builder.ts",
    "model:generate": "ts-node scripts/generate-meshy-model.ts",
    "image:generate": "ts-node scripts/generate-meshy-image.ts",
    "readme:update": "ts-node scripts/update-readme-featured.ts",
    "pipeline:inspect": "ts-node packages/3d-pipeline/src/inspect-vram.ts"
  },
  "devDependencies": {
    "turbo": "^1.13.3",
    "typescript": "^5.4.5",
    "ts-node": "^10.9.2",
    "@types/node": "^20.12.7"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "license": "MIT"
}
