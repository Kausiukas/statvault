{
  "name": "@statvault/3d-pipeline",
  "version": "1.0.2",
  "description": "3D asset compression, Draco geometry quantization, and KTX2 texture transcoding pipeline for StatVault WebGL viewports",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "statvault-vram": "./dist/inspect-vram.js"
  },
  "scripts": {
